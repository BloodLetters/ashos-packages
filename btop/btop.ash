echo "\033[01;34m│\033[0m \033[01;36mCore 0:\033[0m \033[01;32m[■■■■■■■■■■■■■■■■■■■■■■■■■■■■              ] 70%\033[0m                            \033[01;34m│\033[0m"
echo "\033[01;34m│\033[0m \033[01;36mCore 1:\033[0m \033[01;32m[■■■■■■■■■■■■■■                            ] 35%\033[0m                            \033[01;34m│\033[0m"
echo "\033[01;34m└──\033[01;34m──────────────────────────────────────────────────────────────────────────────────┘\033[0m"
echo "\033[01;35m┌── \033[01;37mMEMORY & SWAP USAGE \033[01;35m─────────────────────────────────────────────────────────────┐\033[0m"
free
echo "\033[01;35m└──\033[01;35m──────────────────────────────────────────────────────────────────────────────────┘\033[0m"
echo "\033[01;36m┌── \033[01;37mDISKS & MOUNTED FILESYSTEMS \033[01;36m─────────────────────────────────────────────────────┐\033[0m"
