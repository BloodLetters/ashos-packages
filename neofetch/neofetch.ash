echo "\033[01;36m           _/\_          \033[01;32mash\033[00m@\033[01;32m$(cat /proc/sys/kernel/hostname)\033[0m"
echo "\033[01;36m         / o  o \        \033[00m----------------------------------\033[0m"
echo "\033[01;36m        (   ==   )       \033[01;33mOS:\033[00m $(cat /proc/sys/kernel/ostype)"
echo "\033[01;36m         )      (        \033[01;33mKernel:\033[00m $(cat /proc/sys/kernel/osrelease)"
echo "\033[01;36m        /   __   \       \033[01;33mUptime:\033[00m $(cat /proc/uptime)"
echo "\033[01;36m       /  /    \  \      \033[01;33mLoadavg:\033[00m $(cat /proc/loadavg)"
echo "\033[01;36m      (__(      )__)     \033[01;33mCPU:\033[00m $(grep model /proc/cpuinfo)"
echo "\033[01;36m                         \033[01;33mMemory:\033[00m $(grep MemFree /proc/meminfo)"
echo "\033[01;36m                         \033[01;33mTemp:\033[00m $(cat /proc/temperature) C"
echo ""
echo "   \033[40m   \033[41m   \033[42m   \033[43m   \033[44m   \033[45m   \033[46m   \033[47m   \033[0m"
